# Optional — needed only for the Live Traffic Tracker (/tools/live-traffic).
# Free account at https://opensky-network.org, then create an API client under
# your account settings to get these values. Leave blank and the page will show
# setup instructions instead of erroring.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Required for map tiles to render without a watermark. Free key (5M
# requests/month) — get one at https://carto.com/basemaps/apikey and
# enable ONLY "Maps API" on the token, nothing else.
NEXT_PUBLIC_CARTO_API_KEY=

# Optional — leave blank to use fetch() revalidate caching (default, works fine for MVP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — only needed if you later wire up official FAA NOTAM SWIM access
FAA_API_KEY=

# Optional — only needed if you build the EIA jet fuel price widget later
EIA_API_KEY=
